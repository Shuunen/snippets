{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  // configs/files holds verbatim backups of other software's config files, restored as-is onto a
  // fresh machine — reformatting them to this repo's house style only creates sync drift.
  "ignorePatterns": ["**/.git", "**/configs/files", "**/coverage", "**/dist", "**/node_modules", "**/out-tsc", "**/test-output", "**/test-results"],
  "objectWrap": "preserve",
  "printWidth": 240,
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": false,
  "singleQuote": true,
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": false,
  },
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
}
