{
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": false,
  "effortLevel": "medium",
  "enabledPlugins": {
    "convex@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/rtk-wrapper.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.gstack/ship-no-pr-override.sh",
            "type": "command"
          },
          {
            "command": "bash $HOME/.claude/hooks/headroom-autostart.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "_gstack_source": "gstack-timeline-stop",
        "hooks": [
          {
            "command": "$HOME/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "defaultMode": "auto"
  },
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash $HOME/.claude/statusline-command.sh",
    "type": "command"
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "voiceEnabled": false
}
