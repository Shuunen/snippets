{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(localhost:4200)",
      "ClaudeInChromeDomain(localhost:5101)",
      "ClaudeInChromeDomain(localhost:5103)",
      "ClaudeInChromeDomain(localhost:5104)",
      "ClaudeInChromeDomain(localhost:5105)",
      "ClaudeInChromeDomain(localhost:5106)",
      "ClaudeInChromeDomain(localhost:5108)",
      "ClaudeInChromeDomain(localhost:5109)",
      "ClaudeInChromeDomain(localhost:5111)",
      "ClaudeInChromeDomain(localhost:5173)",
      "ClaudeInChromeDomain(localhost:5177)",
      "ClaudeInChromeDomain(localhost:5190)",
      "ClaudeInChromeDomain(localhost:5199)",
      "ClaudeInChromeDomain(localhost:5273)",
      "ClaudeInChromeDomain(localhost:8085)",
      "ClaudeInChromeDomain(www.amazon.fr)",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "ClaudeInChromeDomain(iconscout.com)",
      "Bash(rtk grep *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.gstack/ship-no-pr-override.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/rominou/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' PermissionRequest",
            "timeout": 120
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' Notification",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' StopFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' SubagentStop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "'/home/rominou/.local/share/coucou/bin/coucou-hook' --statusline"
  },
  "enabledPlugins": {
    "convex@claude-plugins-official": true,
    "headroom@headroom-marketplace": false,
    "ponytail@ponytail": false,
    "brag@brag": true,
    "cc-plugin-you-should-know@builtin": false,
    "cc-plugin-telemetry@builtin": false,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — Shuunen/recipes (github.com:Shuunen/recipes.git); any push there is publishing",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch is master; no rulesets and no protected branches listed via gh (public repo — treat master as unprotected)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (Shuunen/recipes) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries prod or production as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries prod or production as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal project — French recipes app, React/TypeScript/Vite)",
      "**Trusted repo**: /home/rominou/Projects/github/recipes (origin: github.com:Shuunen/recipes.git) — PUBLIC, so only this repo's own work belongs here; confidential/secret material is never cleared into it regardless of visibility",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "voiceEnabled": false
}
