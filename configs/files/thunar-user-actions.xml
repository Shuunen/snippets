<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1773148147745532-1</unique-id>
	<command>sh -c 'p=$1; [ -d "$p" ] || p=$(dirname "$p"); exec exo-open --working-directory "$p" --launch TerminalEmulator' _ %f</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>edit-copy</icon>
	<name>Copy Path</name>
	<submenu></submenu>
	<unique-id>1773148147745533-2</unique-id>
	<command>sh -c '"$HOME/.local/bin/copy-path" "$@"' _ %F</command>
	<description>Copy the full path of the selected file(s) to the clipboard</description>
	<range>*</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
</actions>
